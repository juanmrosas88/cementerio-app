# ===========================================
# Cementerio Parque Memorial — Variables de Entorno
# ===========================================
# Copiar este archivo a .env y completar los valores:
#   cp .env.example .env
# ===========================================

# Puerto del servidor API
PORT=3000

# Configuración de PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=usuario_lectura
DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA
DB_NAME=nombre_base

# Orígenes CORS permitidos, separados por coma. Vacío = solo same-origin.
CORS_ORIGINS=

# Solo desarrollo local; mantener desactivado en producción.
ENABLE_DEBUG_ENDPOINTS=false
